# widegraph-default env overlay.
#
# These are the env vars we set BEFORE the per-model launcher runs. The launcher
# may override any of them (its `export VAR=...` lines win); that's intentional
# — the launcher is the source of truth for recipe-critical knobs. This overlay
# just provides defaults for the AITER + unified-attention knobs that most
# launchers leave untouched, and the steady-state ROCm env our sweeps rely on.
#
# To inspect what a given launcher overrides, grep for `export` in
# benchmarks/single_node/<model>_<prec>_<hw>.sh.

# AITER backbone
VLLM_ROCM_USE_AITER=1
VLLM_ROCM_USE_AITER_MOE=1

# Unified attention path (non-MLA models). MLA-aware launchers set their own
# attention backend explicitly; this is harmless when MLA is in use.
VLLM_USE_AITER_UNIFIED_ATTENTION=1
VLLM_ROCM_USE_AITER_UNIFIED_ATTENTION=1
VLLM_ROCM_USE_AITER_MHA=0

# QuickReduce + scratch reclaim — required on every MI355x sweep we've run.
VLLM_ROCM_QUICK_REDUCE_QUANTIZATION=INT4
HSA_NO_SCRATCH_RECLAIM=1
