     def create_event(self, device: object) -> object:
-        """Create a new interprocess-capable event."""
-        return self._event_module.Event(interprocess=True)  # type: ignore[union-attr]
+        """Create a new interprocess-capable event.
+
+        The event is also appended to a bounded retain ring. Callers export the
+        event's IPC handle and then drop their reference, so CPython destroys
+        the event as soon as the creating function returns. HIP/CUDA only defer
+        the real destroy while the recorded work is still outstanding, so once
+        the copy completes the exported handle stops being openable and the
+        importing process gets hipErrorInvalidValue. Holding the last N events
+        keeps every handle openable long after its work has completed. Size via
+        LMCACHE_EVENT_IPC_RETAIN.
+        """
+        event = self._event_module.Event(interprocess=True)  # type: ignore[union-attr]
+        self._retained_events.append(event)
+        return event
 
