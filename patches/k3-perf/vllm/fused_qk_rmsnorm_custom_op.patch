+# K3-LOCAL: with @support_torch_compile on K3DSparkModel the draft forward is
+# traced and Dynamo reaches this Triton kernel. It cannot be traced (the
+# JIT-warmup launcher calls hasattr on a TritonKernelVariable) and it cannot be
+# run on fake tensors, and the compile wrapper uses fullgraph=True so a graph
+# break is unavailable. Register it as a custom op with a meta implementation
+# so tracing gets output metadata without launching the kernel.
+def _fused_q_kv_rmsnorm_fake(
+    qr: torch.Tensor,
+    kv: torch.Tensor,
+    q_weight: torch.Tensor,
+    kv_weight: torch.Tensor,
+    eps: float = 1e-6,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    return (
+        torch.empty_like(qr),
+        torch.empty_like(kv),
+    )
+
+
