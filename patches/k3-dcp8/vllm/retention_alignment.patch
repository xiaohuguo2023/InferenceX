+def _validate_retention_alignment(
+    retention_interval: int | None,
+    alignment_tokens: int,
+) -> None:
+    """Check the retention interval against the *effective* hit granularity.
+
+    A retention checkpoint is only useful where a prefix-cache hit can actually
+    land, so the interval must be a multiple of the alignment a hit is reported
+    at. That alignment is ``scheduler_block_size`` only when fine-grained
+    partial hash hits are off; when they are on it is ``hash_block_size``, which
+    under DCP is ``scheduler_block_size // dcp_world_size``.
+
+    Validating against ``scheduler_block_size`` unconditionally therefore
+    rejects intervals that are perfectly legal under DCP. On Kimi-K3 + DCP8 the
+    KDA/Mamba block is 1536 and DCP scales the full-attention group to 12288, so
+    an interval of 1536 was refused even though every hit is reported at 1536 --
+    forcing an 8x coarser interval that costs ~2pp of prefix-cache hit rate.
+
+    ``enable_partial_hash_hits`` is only settled by the concrete coordinator
+    (``HybridKVCacheCoordinator`` computes it from the Mamba groups), so this
+    runs after ``__init__`` has resolved it, not inside the base constructor.
+    """
+    if retention_interval is None or retention_interval == 0:
+        return
+    if retention_interval % alignment_tokens != 0:
+        raise ValueError(
+            f"prefix_cache_retention_interval ({retention_interval}) must be a "
+            f"multiple of the cache-hit alignment ({alignment_tokens})."
         )
 
 
